{
  "manifest_version": 3,
  "name": "FlowChat for HyperChat",
  "version": "1.0.0",
  "description": "HyperChat互換のニコニコ風コメントフロー拡張機能 - YouTubeライブ配信のチャットを動画上に流します",
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch?*",
        "https://www.youtube.com/live/*"
      ],
      "js": [
        "content/hyperchat-connector.js",
        "content/flow-controller.js",
        "content/main.js"
      ],
      "css": [
        "content/flow-chat.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "js": [
        "content/hyperchat-connector.js",
        "content/flow-controller.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    },
    "default_title": "FlowChat for HyperChat - 設定"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
